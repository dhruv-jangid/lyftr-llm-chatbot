# ---- Backend configuration (copy to .env and fill in real values) ----

# Comma-separated key pool, at least 2 keys. Ids are key_1, key_2, ... in this order.
# Tip: create each Gemini key in a DIFFERENT Google Cloud project (quota is per project).
LLM_API_KEYS=your-first-gemini-key,your-second-gemini-key

# LiteLLM model name (provider/model).
LLM_MODEL=gemini/gemini-3.5-flash-lite

# SQLite location. In Docker this is the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins allowed to call the backend.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# true enables the X-Simulate-Failure header on POST /chat.
ENABLE_FAILURE_SIMULATION=true

# Optional
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
LLM_TIMEOUT_SECONDS=30
